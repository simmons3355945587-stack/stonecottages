# ==============================================
# Vocabulary Survival Configuration (.env)
# ==============================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000

# JWT Token Secret (Auto-generated on first run if left blank)
JWT_SECRET=

# Database Path (Default: ./vocab.db)
DATABASE_PATH=vocab.db

# Optional: Default Server-side Gemini API Key (Users can also provide their own key in the UI)
DEFAULT_GEMINI_API_KEY=
