  <script>
    // ================= 全局状态 =================
    let currentUser = null;
    let isLin = false;
    let ws = null;
    let wsRetryTimer = null, wsRetryAttempt = 0, wsLeaving = false;
    function scheduleWsRetry() {
      clearTimeout(wsRetryTimer);
      if (wsLeaving || navigator.onLine === false) return;
      const delay = Math.min(30000, 1500 * 2 ** Math.min(wsRetryAttempt++, 5));
      wsRetryTimer = setTimeout(initWebSocket, delay + Math.random() * 500);
    }
    window.addEventListener('offline', () => clearTimeout(wsRetryTimer));
    window.addEventListener('online', () => { wsRetryAttempt = 0; initWebSocket(); });
    window.addEventListener('pagehide', () => { wsLeaving = true; clearTimeout(wsRetryTimer); ws?.close(); });
    window.addEventListener('pageshow', e => { if (e.persisted) { wsLeaving = false; initWebSocket(); } });
    let myClientId = 'user_' + Math.floor(Math.random() * 100000);
    let currentRoom = null;
    let currentCipher = null;
    let hostScope = 'cet4_core';
    let hostRounds = 3;
    let totalRounds = 3;
    let currentRoundIndex = 0;

    let myScore = 0;
    let oppScore = 0;
    let myCombo = 1;

    // 当轮两段真实语料
    let currentWord = "";
    let passageTop = null;
    let passageBottom = null;

    // 出题状态
    let selectedPassageId = null; // 'p1' 或 'p2'
    let selectedClueWords = [];   // 玩家点选的单词列表
    let currentAiVerdict = null;  // AI 终审结果

    // 解题状态
    let swappedChallenge = null;

    let autoJoinCipher = null;

    document.addEventListener('DOMContentLoaded', () => {
      initTheme();
      checkIdentity();
      updateMarkedWordsUI();
      initWebSocket();
      fetchAiStatus();
    });

    function initTheme() {
      const savedTheme = localStorage.getItem('vocab_theme_mode') || 'light';
      document.documentElement.setAttribute('data-theme', savedTheme);
      const btn = document.getElementById('themeToggleBtn');
      if (btn) btn.textContent = savedTheme === 'dark' ? '🌙' : '☀️';
    }

    function toggleTheme() {
      const cur = document.documentElement.getAttribute('data-theme') || 'light';
      const nxt = cur === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', nxt);
      try { localStorage.setItem('vocab_theme_mode', nxt); } catch(e){}
      const btn = document.getElementById('themeToggleBtn');
      if (btn) btn.textContent = nxt === 'dark' ? '🌙' : '☀️';
    }

    function getLocalMarkedWords() {
      try {
        let m = null;
        const v2 = localStorage.getItem('vocab_marks_v2');
        if (v2) m = JSON.parse(v2);
        if (!m) {
          const v1 = localStorage.getItem('vocab_marks');
          if (v1) m = JSON.parse(v1);
        }
        if (m && typeof m === 'object') {
          return Object.keys(m).filter(w => m[w] > 0);
        }
      } catch (e) {}
      return [];
    }

