    function checkIdentity() {
      const urlParams = new URLSearchParams(window.location.search);
      const urlUser = urlParams.get('user') || urlParams.get('auth');
      const logout = urlParams.get('logout');
      autoJoinCipher = urlParams.get('k') || urlParams.get('c') || urlParams.get('cipher');

      if (logout) localStorage.removeItem('battle_is_lin');

      if (urlUser && (urlUser === 'lin' || urlUser === '林允安' || urlUser === '允安')) {
        localStorage.setItem('battle_is_lin', 'true');
        currentUser = { username: '林允安', is_admin: true };
      } else if (!autoJoinCipher && localStorage.getItem('battle_is_lin') === 'true') {
        currentUser = { username: '林允安', is_admin: true };
      } else {
        try {
          const stored = localStorage.getItem('stone_auth');
          if (stored) {
            const parsed = JSON.parse(stored);
            if (parsed && (['林允安', '允安'].includes(parsed.username) || parsed.is_admin)) {
              localStorage.setItem('battle_is_lin', 'true');
              currentUser = parsed;
            }
          }
        } catch (e) {}
      }

      if (currentUser && (['林允安', '允安'].includes(currentUser.username) || currentUser.is_admin)) {
        isLin = true;
        document.getElementById('hostConsoleCard').style.display = 'block';
        document.getElementById('guestConsoleCard').style.display = 'none';
        const toggleBtn = document.getElementById('hostModeToggleBtn');
        if (toggleBtn) {
          toggleBtn.style.display = 'inline-flex';
          toggleBtn.textContent = '切换为应战视角';
        }
      } else {
        isLin = false;
        document.getElementById('hostConsoleCard').style.display = 'none';
        document.getElementById('guestConsoleCard').style.display = 'block';

        if (autoJoinCipher) {
          const cleanK = autoJoinCipher.trim();
          const inputEl = document.getElementById('inputCipherCode');
          if (inputEl) inputEl.value = cleanK;
          const notice = document.getElementById('guestAutoJoinNotice');
          if (notice) {
            notice.style.display = 'block';
            notice.innerHTML = `⚡ 识别到对决直达密令 <strong style="color: var(--arena-accent); font-family: var(--font-mono, monospace);">${cleanK}</strong>，正在免密秒进房间...`;
          }
        }
      }
    }

