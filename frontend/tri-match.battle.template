<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>私人对决 · 语境消歧双向竞技场 (.battle) | Our Stone Cottages</title>
  <link rel="stylesheet" href="style.css">
  <link rel="stylesheet" href="ui-enhancements.css">
  <style>
    /* =========================================================
       对决竞技场折纸视觉系统 (Aligned with Our Stone Cottages)
       ========================================================= */
    :root {
      --arena-primary: var(--brand-primary, #4338ca);
      --arena-primary-light: var(--brand-primary-light, #4f46e5);
      --arena-primary-glow: var(--brand-accent-glow, rgba(217, 119, 6, 0.2));
      --arena-accent: var(--brand-accent, #d97706);
      --arena-success: var(--brand-success, #059669);
      --arena-danger: var(--brand-danger, #dc2626);
      --card-bg: var(--paper-surface, #fdfbf7);
      --card-sub: var(--paper-surface-sub, #f0e8dc);
      --card-border: var(--paper-border, #d6c8b4);
      --text-main: var(--text-primary, #2d261e);
      --text-sub: var(--text-secondary, #6e6254);
      --kw-highlight: var(--brand-accent, #d97706);
      --kw-bg: rgba(217, 119, 6, 0.15);
    }

    [data-theme="dark"] {
      --arena-primary: var(--brand-primary, #6366f1);
      --arena-primary-light: var(--brand-primary-light, #818cf8);
      --arena-primary-glow: var(--brand-accent-glow, rgba(245, 158, 11, 0.25));
      --arena-accent: var(--brand-accent, #f59e0b);
      --arena-success: var(--brand-success, #10b981);
      --arena-danger: var(--brand-danger, #ef4444);
      --card-bg: var(--paper-surface, #161c28);
      --card-sub: var(--paper-surface-sub, #1e2636);
      --card-border: var(--paper-border, #2a364d);
      --text-main: var(--text-primary, #f1f5f9);
      --text-sub: var(--text-secondary, #94a3b8);
      --kw-highlight: #fbbf24;
      --kw-bg: rgba(245, 158, 11, 0.22);
    }

    body {
      font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
      background: var(--bg-main, #f5efe6);
      background-image: var(--bg-pattern);
      color: var(--text-main);
      margin: 0;
      padding: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      transition: background 0.3s ease, color 0.3s ease;
    }

    /* 顶栏 */
    .arena-header {
      background: var(--card-bg);
      background-image: var(--paper-crease);
      border-bottom: 2px solid var(--card-border);
      padding: 12px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      box-shadow: 0 4px 15px rgba(0,0,0,0.06);
    }

    .brand-title {
      font-size: 15.5px;
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .cipher-badge {
      background: var(--arena-primary);
      border: 1px solid var(--arena-primary-light);
      color: #fff;
      font-size: 11px;
      font-weight: 800;
      padding: 2px 8px;
      border-radius: 999px;
      letter-spacing: 0.5px;
    }

    .arena-container {
      max-width: 860px;
      margin: 0 auto;
      padding: 16px 14px 90px 14px;
      width: 100%;
      box-sizing: border-box;
      flex: 1;
    }

    /* 折纸卡片容器 */
    .glass-card {
      background: var(--card-bg);
      background-image: var(--paper-crease);
      border: 2px solid var(--card-border);
      border-radius: var(--radius-lg, 20px);
      padding: 22px;
      box-shadow: var(--paper-shadow);
      margin-bottom: 18px;
    }

    .auth-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--card-sub);
      background-image: var(--paper-crease);
      border: 1.5px solid var(--card-border);
      border-radius: var(--radius-md, 14px);
      padding: 12px 16px;
      margin-bottom: 16px;
      box-shadow: 2px 2px 0px var(--card-border);
    }

    .cipher-box {
      background: var(--card-sub);
      background-image: var(--paper-crease);
      border: 2px dashed var(--arena-accent);
      border-radius: var(--radius-lg, 20px);
      padding: 18px;
      text-align: center;
      margin: 16px 0;
      box-shadow: var(--paper-shadow);
    }

    .cipher-code {
      font-size: 32px;
      font-weight: 900;
      color: var(--arena-accent);
      letter-spacing: 2px;
      margin: 8px 0;
      font-family: var(--font-mono, monospace);
    }

    /* 纸艺触感按钮系统 */
    .btn-action {
      padding: 12px 20px;
      background: linear-gradient(135deg, var(--arena-primary) 0%, #312e81 100%);
      color: #ffffff;
      border: 2px solid var(--arena-primary);
      border-radius: var(--radius-md, 14px);
      font-size: 15px;
      font-weight: 800;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: var(--paper-shadow);
      transition: var(--transition-fast, 0.2s cubic-bezier(0.4, 0, 0.2, 1));
      text-decoration: none;
      box-sizing: border-box;
    }

    [data-theme="dark"] .btn-action {
      background: linear-gradient(135deg, var(--arena-primary) 0%, #4338ca 100%);
    }

    .btn-action:hover {
      transform: translateY(-2px);
      filter: brightness(1.06);
    }

    .btn-action:active {
      transform: translateY(1px);
      box-shadow: var(--paper-shadow-active);
    }

    .btn-action:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      transform: none !important;
      box-shadow: none !important;
      filter: grayscale(0.4);
    }

    .btn-action.btn-accent, .btn-accent {
      background: linear-gradient(135deg, var(--arena-accent) 0%, #b45309 100%) !important;
      border-color: var(--arena-accent) !important;
      color: #ffffff !important;
      box-shadow: var(--paper-shadow) !important;
    }
    .btn-action.btn-accent:hover, .btn-accent:hover {
      filter: brightness(1.08);
      transform: translateY(-2px);
    }

    .btn-action.btn-success, .btn-success {
      background: linear-gradient(135deg, var(--arena-success) 0%, #065f46 100%) !important;
      border-color: var(--arena-success) !important;
      color: #ffffff !important;
      box-shadow: var(--paper-shadow) !important;
    }

    .btn-action.btn-subtle {
      background: var(--card-sub) !important;
      border-color: var(--card-border) !important;
      color: var(--text-main) !important;
      box-shadow: 2px 2px 0px var(--card-border) !important;
    }

    /* 范围网格与生词卡 */
    .scope-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 10px;
      margin-bottom: 14px;
    }

    .scope-item {
      border: 2px solid var(--card-border);
      border-radius: var(--radius-md, 14px);
      padding: 12px 14px;
      cursor: pointer;
      background: var(--card-bg);
      box-shadow: 2px 2px 0px var(--card-border);
      transition: var(--transition-fast, 0.2s);
    }

    .scope-item:hover {
      border-color: var(--arena-primary);
      transform: translateY(-2px);
    }

    .scope-item.active {
      border-color: var(--arena-primary);
      background: var(--card-sub);
      box-shadow: 0 0 0 2px var(--arena-primary-glow), var(--paper-shadow);
    }

    .marked-scope-card {
      background: var(--card-sub);
      border: 2px solid var(--card-border);
      border-radius: var(--radius-md, 14px);
      padding: 12px 16px;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      box-shadow: 2px 2px 0px var(--card-border);
      transition: all 0.2s;
    }

    .marked-scope-card:hover {
      border-color: var(--arena-accent);
      transform: translateY(-1px);
    }

    .marked-scope-card.checked {
      border-color: var(--arena-accent);
      background: rgba(217, 119, 6, 0.08);
      box-shadow: 0 0 0 2px rgba(217, 119, 6, 0.25), var(--paper-shadow);
    }

    .filter-pill {
      padding: 6px 14px;
      border: 1.5px solid var(--card-border);
      border-radius: 999px;
      background: var(--card-bg);
      font-size: 12.5px;
      font-weight: 700;
      color: var(--text-sub);
      cursor: pointer;
      box-shadow: 1px 1px 0px var(--card-border);
      transition: var(--transition-fast, 0.2s);
    }

    .filter-pill.active {
      background: var(--arena-primary);
      color: #fff;
      border-color: var(--arena-primary);
    }

    /* 战况 HUD */
    .battle-hud {
      background: var(--card-bg);
      background-image: var(--paper-crease);
      border: 2px solid var(--card-border);
      border-radius: var(--radius-lg, 20px);
      padding: 16px 20px;
      margin-bottom: 16px;
      box-shadow: var(--paper-shadow);
    }

    .target-word-display {
      font-size: 26px;
      font-weight: 900;
      color: var(--arena-primary);
      letter-spacing: 0.5px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .hud-status-bar {
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1.5px dashed var(--card-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
    }

    /* =========================================================
       移动端上下竖排段落卡片与词语点选系统
       ========================================================= */
    .passage-stack {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 20px;
    }

    .passage-card {
      background: var(--card-bg);
      background-image: var(--paper-crease);
      border: 2px solid var(--card-border);
      border-radius: var(--radius-lg, 18px);
      padding: 18px 20px;
      box-shadow: var(--paper-shadow);
      position: relative;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .passage-card.selected-source {
      border-color: var(--arena-accent);
      box-shadow: 0 0 0 2.5px rgba(217, 119, 6, 0.35), var(--paper-shadow);
    }

    .passage-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
      padding-bottom: 8px;
      border-bottom: 1.5px dashed var(--card-border);
    }

    .passage-badge {
      font-size: 12px;
      font-weight: 800;
      padding: 3px 10px;
      border-radius: 999px;
      background: var(--card-sub);
      color: var(--arena-primary);
      border: 1px solid var(--card-border);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .passage-body {
      font-size: 15.5px;
      line-height: 1.75;
      color: var(--text-main);
      word-break: break-word;
      user-select: none;
      -webkit-user-select: none;
    }

    /* 单词点选高亮 Token */
    .word-token {
      cursor: pointer;
      display: inline-block;
      padding: 1px 3px;
      margin: 0 1px;
      border-radius: 4px;
      transition: all 0.15s ease;
    }

    .word-token:hover {
      background: var(--card-sub);
      text-decoration: underline;
    }

    .word-token.clue-selected {
      background: #fef3c7 !important;
      color: #92400e !important;
      font-weight: 800 !important;
      border: 1.5px solid #d97706 !important;
      border-radius: 5px !important;
      box-shadow: 0 2px 6px rgba(217, 119, 6, 0.25) !important;
    }

    [data-theme="dark"] .word-token.clue-selected {
      background: rgba(245, 158, 11, 0.25) !important;
      color: #fbbf24 !important;
      border: 1.5px solid #f59e0b !important;
    }

    .target-word-chip {
      background: var(--arena-primary) !important;
      color: #ffffff !important;
      font-weight: 900 !important;
      padding: 2px 7px !important;
      border-radius: 6px !important;
      box-shadow: 1px 1px 0px rgba(0,0,0,0.2) !important;
      display: inline-block !important;
      margin: 0 2px !important;
    }

    /* 浮动出题线索栏 (Sticky Bottom Tray) */
    .floating-clue-tray {
      background: var(--card-bg);
      background-image: var(--paper-crease);
      border: 2px solid var(--card-border);
      border-radius: var(--radius-lg, 18px);
      padding: 14px 18px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.15);
      position: sticky;
      bottom: 16px;
      z-index: 95;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }

    .clue-chips-wrap {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 8px 0;
      min-height: 28px;
      align-items: center;
    }

    .active-clue-chip {
      background: rgba(217, 119, 6, 0.15);
      color: var(--arena-accent);
      border: 1.5px solid var(--arena-accent);
      font-size: 12.5px;
      font-weight: 800;
      padding: 3px 10px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    /* AI 终审检验卡片 */
    .ai-verdict-box {
      background: var(--card-sub);
      background-image: var(--paper-crease);
      border: 2px solid var(--arena-accent);
      border-radius: var(--radius-md, 14px);
      padding: 16px;
      margin-top: 14px;
      box-shadow: var(--paper-shadow);
      display: none;
    }

    .gold-keyword-chip {
      background: rgba(217, 119, 6, 0.12);
      color: var(--arena-accent);
      border: 1.5px solid var(--arena-accent);
      font-size: 12.5px;
      font-weight: 800;
      padding: 3px 10px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      box-shadow: 1px 1px 0px rgba(217, 119, 6, 0.2);
      transition: all 0.2s ease;
    }

    .badge-sense {
      background: rgba(67, 56, 202, 0.1);
      color: var(--arena-primary);
      border: 1.5px solid var(--arena-primary-light);
      font-size: 13.5px;
      font-weight: 800;
      padding: 2px 10px;
      border-radius: 8px;
      display: inline-block;
    }

    [data-theme="dark"] .badge-sense {
      background: rgba(99, 102, 241, 0.2);
      color: #a5b4fc;
      border-color: #6366f1;
    }

    /* 弹窗通用体系 */
    .insights-modal {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 999;
    }

    .insights-card {
      background: var(--card-bg);
      background-image: var(--paper-crease);
      border: 2px solid var(--card-border);
      border-radius: var(--radius-lg, 20px);
      max-width: 620px;
      width: 100%;
      padding: 24px;
      max-height: 88vh;
      overflow-y: auto;
      box-shadow: var(--paper-shadow);
      box-sizing: border-box;
    }
  </style>
</head>
<body>

  <!-- 顶栏 -->
  <div class="arena-header">
    <div class="brand-title">
      <span>⚔️ 语境消歧 · 私人双向对决</span>
      <span class="cipher-badge">/pk 专线</span>
      <span id="serverStatusBadge" style="font-size: 11px; padding: 2px 8px; border-radius: 999px; font-weight: 700; background: rgba(16, 185, 129, 0.15); color: #10b981; margin-left: 6px;">🟢 联机中</span>
    </div>
    <div style="display: flex; align-items: center; gap: 8px;">
      <button class="paper-icon-btn" onclick="openAiSettingsModal()" title="查看/配置真实 AI 调度引擎 (Gemini/MIMO)" style="font-size: 13px; padding: 4px 10px; width: auto; height: 36px; font-weight: 800;">⚡ AI引擎</button>
      <button class="paper-icon-btn" onclick="toggleHostMode()" id="hostModeToggleBtn" style="display: none; font-size: 11px; font-weight: 800; padding: 4px 8px; width: auto; height: 36px;">切换视角</button>
      <a href="index.html" class="paper-icon-btn" style="text-decoration: none; font-size: 13px; font-weight: 700; padding: 6px 12px; width: auto; height: 36px;">返回石屋</a>
      <button class="paper-icon-btn" onclick="toggleTheme()" id="themeToggleBtn" title="切换昼夜折纸主题" style="width: 36px; height: 36px;">🌙</button>
    </div>
  </div>

  <div class="arena-container">

    <!-- ================= 视图 A: 房主控制台 (仅限林允安) ================= -->
    <div id="hostConsoleCard" class="glass-card" style="display: none;">
      <div class="auth-banner">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-size: 26px;">👑</span>
          <div>
            <div style="font-weight: 900; font-size: 15px; color: var(--arena-primary);">房主身份已认证：林允安</div>
            <div style="font-size: 12px; color: var(--text-sub);">独家发起权已解锁 · 每次创建均生成全新加密战令</div>
          </div>
        </div>
        <span class="origami-chip" style="background: var(--arena-success); color: white; font-size: 11px; padding: 3px 10px; border-radius: 8px; font-weight: 700;">房主专线在线</span>
      </div>

      <!-- Mark 重点生词勾选卡 -->
      <div id="markedCheckboxCard" class="marked-scope-card" onclick="toggleMarkedOnlyCheckbox()">
        <div style="display: flex; align-items: center; gap: 14px;">
          <input type="checkbox" id="chkOnlyMarked" style="width: 20px; height: 20px; accent-color: var(--arena-accent); cursor: pointer;" onclick="event.stopPropagation(); onMarkedOnlyChanged();">
          <div>
            <div style="font-weight: 800; font-size: 14.5px; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
              <span>★ 仅从我的 Mark 重点生词本出题</span>
              <span id="markedBadge" class="cipher-badge" style="background: var(--arena-accent); border-color: var(--arena-accent); font-size: 11px;">0 词</span>
            </div>
            <div style="font-size: 12px; color: var(--text-sub); margin-top: 3px;">
              勾选后对决题目将全量从你主站 Mark 的重点生词中筛选出题（双段同词，真题语境消歧）
            </div>
          </div>
        </div>
        <div id="markedStatusNote" style="font-size: 12.5px; font-weight: 800; color: var(--arena-accent); white-space: nowrap;">
          检测生词中...
        </div>
      </div>

      <div style="font-weight: 800; font-size: 14px; margin-bottom: 8px;">📚 划定备选词库：</div>
      <div class="scope-grid">
        <div class="scope-item active" onclick="setHostScope('cet4_core', this)">
          <div style="font-weight: 800; font-size: 13px;">📖 CET-4 核心词库</div>
          <div style="font-size: 11px; color: var(--text-sub);">高频精选真题语段</div>
        </div>
        <div class="scope-item" onclick="setHostScope('polysemy_top50', this)">
          <div style="font-weight: 800; font-size: 13px;">🌟 一词多义巅峰榜</div>
          <div style="font-size: 11px; color: var(--text-sub);">易混淆对比语境</div>
        </div>
        <div class="scope-item" onclick="setHostScope('news_tech', this)">
          <div style="font-weight: 800; font-size: 13px;">📰 前沿科技与时评</div>
          <div style="font-size: 11px; color: var(--text-sub);">当代权威真实语段</div>
        </div>
      </div>

      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px;">
        <span style="font-weight: 800; font-size: 14px;">⏱️ 对决题数：</span>
        <div style="display: flex; gap: 8px;">
          <button class="filter-pill active" onclick="setHostRounds(3, this)">3 题短跑</button>
          <button class="filter-pill" onclick="setHostRounds(5, this)">5 题标准</button>
          <button class="filter-pill" onclick="setHostRounds(10, this)">10 题巅峰</button>
        </div>
      </div>

      <!-- 生成新密令行动按钮 -->
      <div id="createRoomActionBox">
        <button class="btn-action" style="width: 100%; font-size: 16px; padding: 15px;" onclick="doCreateRoomAsLin()">
          <span>🔥 开启对决 · 生成专属加密战令</span>
          <span>⚡</span>
        </button>
      </div>

      <!-- 密令已生成战报面板 -->
      <div id="roomCipherCreatedBox" style="display: none;">
        <div class="cipher-box">
          <div style="font-size: 13px; font-weight: 800; color: var(--text-sub);">今日对决战令已封印生效 (8位高熵)：</div>
          <div class="cipher-code" id="displaySecretCipher">7&*9#@3*</div>
          <div style="font-size: 12px; color: var(--arena-primary); margin: 8px 0 12px 0; font-weight: 700; word-break: break-all; background: var(--card-bg); padding: 10px; border-radius: 10px; border: 1.5px solid var(--card-border);" id="displayDirectLinkBox">
            🔗 直达链接：<span id="displayDirectLinkUrl" style="text-decoration: underline;">https://ourstonecottages.org/pk?k=...</span>
          </div>
          <button class="btn-action btn-accent" style="padding: 11px 22px; font-size: 14px;" onclick="copyBattleInvite()">
            <span>📋 复制战帖 (好友点开即进)</span>
