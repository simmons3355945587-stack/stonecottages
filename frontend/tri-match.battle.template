      currentWord = data.word;
      passageTop = data.passage_top;
      passageBottom = data.passage_bottom;

      selectedPassageId = null;
      selectedClueWords = [];
      currentAiVerdict = null;

      document.getElementById('battleWordText').textContent = currentWord;
      document.getElementById('battleRoundProgressLabel').textContent = `第 ${currentRoundIndex + 1} / ${totalRounds} 词 · ${currentWord}`;
      document.getElementById('aiVerdictBox').style.display = 'none';
