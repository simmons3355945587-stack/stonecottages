    // ================= WebSocket 通信 =================
    function initWebSocket() {
      if (wsLeaving || navigator.onLine === false || (ws && (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING))) return;
      clearTimeout(wsRetryTimer);
      let wsUrl;
      const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
      if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
        wsUrl = `ws://${window.location.hostname}:8088/ws/${myClientId}`;
      } else if (!window.location.hostname) {
        wsUrl = `ws://localhost:8088/ws/${myClientId}`;
      } else {
        wsUrl = `${proto}//${window.location.host}/ws/${myClientId}`;
      }

      console.log("Connecting WebSocket to:", wsUrl);
      try {
        ws = new WebSocket(wsUrl);
        ws.onopen = () => {
          wsRetryAttempt = 0;
          console.log("WebSocket connected.");
          const b = document.getElementById('serverStatusBadge');
          if (b) {
            b.textContent = "🟢 战场联机正常";
            b.style.background = "rgba(16, 185, 129, 0.15)";
            b.style.color = "#10b981";
          }
          if (!isLin && autoJoinCipher) {
            doJoinWithCipher(autoJoinCipher);
          }
        };
        ws.onmessage = (e) => handleWsMessage(JSON.parse(e.data));
        ws.onerror = (e) => {
          console.log("WS error:", e);
          const b = document.getElementById('serverStatusBadge');
          if (b) {
            b.textContent = "🔴 联机重试中";
            b.style.background = "rgba(239, 68, 68, 0.15)";
            b.style.color = "#ef4444";
          }
        };
        ws.onclose = () => {
          const b = document.getElementById('serverStatusBadge');
          if (b) {
            b.textContent = "⚪ 正在重新连接...";
            b.style.background = "rgba(148, 163, 184, 0.15)";
            b.style.color = "#64748b";
          }
          scheduleWsRetry();
        };
      } catch (e) {
        console.log("WebSocket failed:", e);
        scheduleWsRetry();
      }
    }

    function doCreateRoomAsLin() {
      if (!isLin) {
        alert("🔒 权限拦截：多人对决仅限【林允安】账号发起！");
        return;
      }
      if (!ws || ws.readyState !== WebSocket.OPEN) {
        initWebSocket();
        setTimeout(doCreateRoomAsLin, 500);
        return;
      }

      const onlyMarked = document.getElementById('chkOnlyMarked')?.checked || false;
      const markedWords = getLocalMarkedWords();

      ws.send(JSON.stringify({
        action: 'create_room',
        name: '林允安',
        scope: onlyMarked ? 'marked_only' : hostScope,
        rounds: hostRounds,
        only_marked: onlyMarked,
        marked_words: markedWords,
        is_admin: true
      }));
    }

    function doJoinWithCipher(overrideCipher) {
      let cipher = (overrideCipher || document.getElementById('inputCipherCode').value).trim();
      cipher = cipher.replace(/^[【\["']+|[】\]"']+$/g, '').trim();

      let savedName = localStorage.getItem('battle_guest_name');
      let inputName = document.getElementById('inputGuestName').value.trim();
      let guestName = inputName || savedName || `学友${Math.floor(10 + Math.random() * 89)}`;

      if (inputName) localStorage.setItem('battle_guest_name', inputName);
      document.getElementById('inputGuestName').value = guestName;

      if (!cipher) {
        alert("⚠️ 请输入房主【林允安】下发的对决密令！");
        return;
      }
      if (!ws || ws.readyState !== WebSocket.OPEN) {
        initWebSocket();
        setTimeout(() => doJoinWithCipher(cipher), 500);
        return;
      }
      currentCipher = cipher;
      ws.send(JSON.stringify({
        action: 'join_room',
        cipher: cipher,
        name: guestName
      }));
    }

    function doLaunchMatch() {
      if (ws && currentRoom) {
        ws.send(JSON.stringify({
          action: 'start_game',
          room_id: currentRoom.room_id
        }));
      }
    }

    // ================= 消息分发 =================
    function handleWsMessage(msg) {
      if (msg.event === 'room_created') {
        currentRoom = msg.room_state;
        currentCipher = msg.cipher;
        document.getElementById('createRoomActionBox').style.display = 'none';
        document.getElementById('roomCipherCreatedBox').style.display = 'block';
        document.getElementById('displaySecretCipher').textContent = msg.cipher;

        const directUrl = `${window.location.origin}/pk?k=${encodeURIComponent(msg.cipher)}`;
        const linkEl = document.getElementById('displayDirectLinkUrl');
        if (linkEl) linkEl.textContent = directUrl;

        updatePlayersList(msg.room_state.players);
      }
      else if (msg.event === 'room_joined') {
        currentRoom = msg.room_state;
        document.getElementById('guestWaitNotice').style.display = 'block';
      }
      else if (msg.event === 'player_list_updated') {
        updatePlayersList(msg.players);
      }
      else if (msg.event === 'game_started' || msg.event === 'new_round') {
        totalRounds = msg.total_rounds || 3;
        currentRoundIndex = msg.round_index || 0;
        document.getElementById('roundReviewModal').style.display = 'none';
        startRound(msg);
      }
      else if (msg.event === 'clue_verified') {
        renderAiVerdict(msg.result);
      }
      else if (msg.event === 'opponent_challenge_ready') {
        if (msg.client_id !== myClientId) {
          showToast(`⚡ 对手【${msg.player_name}】已封印出题考卷！`);
        }
      }
      else if (msg.event === 'challenges_swapped') {
        handleChallengesSwapped(msg);
      }
      else if (msg.event === 'round_resolved') {
        handleRoundResolved(msg);
      }
      else if (msg.event === 'ready_status_update') {
        const txt = `${msg.ready_count} / ${msg.total_players}`;
        const lbl = document.getElementById('reviewReadyCountText');
        if (lbl) lbl.textContent = txt;
        if (msg.ready_clients && msg.ready_clients.includes(myClientId)) {
          const btn = document.getElementById('btnReadyNextRound');
          if (btn) {
            btn.innerHTML = `<span>⏳ 已就绪 · 等待其他玩家 (${txt})</span>`;
            btn.disabled = true;
          }
        }
      }
      else if (msg.event === 'match_completed') {
        document.getElementById('roundReviewModal').style.display = 'none';
        showFinalCompletedModal(msg.leaderboard);
      }
      else if (msg.event === 'error') {
        alert(msg.message);
      }
    }

    function updatePlayersList(playersObj) {
      const list = Array.isArray(playersObj) ? playersObj : Object.values(playersObj);
      const wrap = document.getElementById('playersListWrap');
