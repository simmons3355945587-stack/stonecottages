    // ================= 阶段 1: 渲染与分词点选 =================
    function startRound(data) {
      document.getElementById('hostConsoleCard').style.display = 'none';
      document.getElementById('guestConsoleCard').style.display = 'none';
      document.getElementById('battlePlayView').style.display = 'block';

      document.getElementById('craftingSection').style.display = 'block';
      document.getElementById('solvingSection').style.display = 'none';
